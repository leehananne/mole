# Input is crowding (bad), we want comfort (good).
calc_crowd_score <- function(crowd_ratio) {
# Invert the ratio: 0.1 crowd -> 0.9 comfort -> 9.0 score
score <- (1 - crowd_ratio) * 10
return(score)
}
# Function to calculate Accessibility Score (Ac)
