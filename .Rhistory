install.packages("sf")
all_stations_list <- list()
for (mode_group in names(urls)) {
url <- urls[[mode_group]]
message("Fetching data for: ", mode_group, " from ", url)
tryCatch({
response <- httr::GET(url, timeout(30)) # Longer timeout for potentially large responses
stop_for_status(response) # Check for HTTP errors (like 404, 500)
json_content <- httr::content(response, "text", encoding = "UTF-8")
parsed_data <- jsonlite::fromJSON(json_content, flatten = TRUE, simplifyDataFrame = TRUE)
stations_df <- parsed_data$stopPoints
if (is.data.frame(stations_df) && nrow(stations_df) > 0) {
message("Successfully parsed ", nrow(stations_df), " stop points for ", mode_group)
stations_df$modeGroupFetched <- mode_group # Add source info
all_stations_list[[mode_group]] <- stations_df
} else {
warning("No stopPoints data frame found or it was empty for ", mode_group)
}
}, error = function(e) {
warning("!!! Error fetching or parsing data for ", mode_group, ": ", e$message)
})
} # End loop
# Combine if list is not empty
if (length(all_stations_list) > 0) {
combined_df <- bind_rows(all_stations_list)
message("Combined data frame created with ", nrow(combined_df), " total rows.")
return(combined_df)
} else {
message("Failed to fetch any data from TfL API.")
return(data.frame()) # Return empty data frame on complete failure
}
fetch_and_process_tfl_stoppoints <- function() {
urls <- c(
tube = "https://api.tfl.gov.uk/StopPoint/Mode/tube",
elizabeth_overground = "https://api.tfl.gov.uk/StopPoint/Mode/elizabeth-line,overground"
)
all_stations_list <- list()
for (mode_group in names(urls)) {
url <- urls[[mode_group]]
message("Fetching data for: ", mode_group, " from ", url)
tryCatch({
response <- httr::GET(url, timeout(30)) # Longer timeout for potentially large responses
stop_for_status(response) # Check for HTTP errors (like 404, 500)
json_content <- httr::content(response, "text", encoding = "UTF-8")
parsed_data <- jsonlite::fromJSON(json_content, flatten = TRUE, simplifyDataFrame = TRUE)
stations_df <- parsed_data$stopPoints
if (is.data.frame(stations_df) && nrow(stations_df) > 0) {
message("Successfully parsed ", nrow(stations_df), " stop points for ", mode_group)
stations_df$modeGroupFetched <- mode_group # Add source info
all_stations_list[[mode_group]] <- stations_df
} else {
warning("No stopPoints data frame found or it was empty for ", mode_group)
}
}, error = function(e) {
warning("!!! Error fetching or parsing data for ", mode_group, ": ", e$message)
})
} # End loop
# Combine if list is not empty
if (length(all_stations_list) > 0) {
combined_df <- bind_rows(all_stations_list)
message("Combined data frame created with ", nrow(combined_df), " total rows.")
return(combined_df)
} else {
message("Failed to fetch any data from TfL API.")
return(data.frame()) # Return empty data frame on complete failure
}
}
# Execute the function
tfl_stations_df <- fetch_and_process_tfl_stoppoints()
# --- 2. Explore the TfL API Data ---
if (nrow(tfl_stations_df) > 0) {
message("\n--- Structure of TfL API Station Data ---")
str(tfl_stations_df)
message("\n--- First 6 Rows of TfL API Station Data ---")
print(head(tfl_stations_df))
message("\n--- Column Names in TfL API Data ---")
print(names(tfl_stations_df))
# Example: Look at distinct stopTypes
message("\n--- Distinct Stop Types found in API data ---")
print(unique(tfl_stations_df$stopType))
# Example: Look at modes (might be list columns, handle carefully)
# message("\n--- Modes ---")
# print(head(tfl_stations_df$modes))
} else {
warning("TfL API data frame is empty.")
}
