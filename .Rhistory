# Loop through each URL
for (mode_group in names(urls)) {
url <- urls[[mode_group]]
message("Fetching data for: ", mode_group, " from ", url)
tryCatch({
response <- httr::GET(url, timeout(20)) # Increased timeout
stop_for_status(response) # Check for HTTP errors
json_content <- httr::content(response, "text", encoding = "UTF-8")
# Use simplifyDataFrame = TRUE for potentially easier conversion
parsed_data <- jsonlite::fromJSON(json_content, flatten = TRUE, simplifyDataFrame = TRUE)
# Extract the stopPoints data frame
stations_df <- parsed_data$stopPoints
if (is.data.frame(stations_df) && nrow(stations_df) > 0) {
message("Successfully parsed ", nrow(stations_df), " stop points for ", mode_group)
# Add a column to know which group it came from (optional)
stations_df$modeGroup <- mode_group
all_stations_list[[mode_group]] <- stations_df
} else {
warning("No stopPoints data frame found or it was empty for ", mode_group)
}
}, error = function(e) {
warning("!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!")
warning("!!! Error fetching or parsing data for ", mode_group, ": ", e$message)
